{
  "name": "openclaw",
  "displayName": "Navyug AI Dev Assistant",
  "description": "Copilot-like AI chat panel powered by Navyug AI backend",
  "version": "0.1.0",
  "publisher": "openclaw",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openclaw-sidebar",
          "title": "Navyug AI",
          "icon": "media/openclaw-icon.svg"
        }
      ]
    },
    "views": {
      "openclaw-sidebar": [
        {
          "type": "webview",
          "id": "openclawChatView",
          "name": "AI ChatAgent",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "openclaw.openChat",
        "title": "Navyug AI: Open Chat Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "openclaw.clearChat",
        "title": "Navyug AI: Clear Chat",
        "icon": "$(clear-all)"
      },
      {
        "command": "openclaw.newSession",
        "title": "Navyug AI: New Session",
        "icon": "$(add)"
      },
      {
        "command": "openclaw.runTool",
        "title": "Navyug AI: Run Tool…",
        "icon": "$(tools)"
      },
      {
        "command": "openclaw.tool.generate_tests",
        "title": "Navyug AI: 🧪 Generate Tests"
      },
      {
        "command": "openclaw.tool.review_code",
        "title": "Navyug AI: 🔍 Review Code"
      },
      {
        "command": "openclaw.tool.find_bugs",
        "title": "Navyug AI: 🐛 Find Bugs"
      },
      {
        "command": "openclaw.tool.explain_code",
        "title": "Navyug AI: 📖 Explain Code"
      },
      {
        "command": "openclaw.tool.refactor_code",
        "title": "Navyug AI: ♻️ Refactor Code"
      },
      {
        "command": "openclaw.tool.generate_docs",
        "title": "Navyug AI: 📝 Generate Docs"
      },
      {
        "command": "openclaw.tool.security_analysis",
        "title": "Navyug AI: 🔒 Security Analysis"
      },
      {
        "command": "openclaw.tool.optimize_performance",
        "title": "Navyug AI: ⚡ Optimize Performance"
      },
      {
        "command": "openclaw.tool.analyze_complexity",
        "title": "Navyug AI: 📊 Analyze Complexity"
      },
      {
        "command": "openclaw.tool.translate_code",
        "title": "Navyug AI: 🔄 Translate Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openclaw.clearChat",
          "when": "view == openclawChatView",
          "group": "navigation"
        },
        {
          "command": "openclaw.newSession",
          "when": "view == openclawChatView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "openclaw.submenu",
          "when": "editorHasSelection",
          "group": "openclaw@1"
        }
      ],
      "openclaw.submenu": [
        {
          "command": "openclaw.tool.generate_tests",
          "group": "1_analyze@1"
        },
        {
          "command": "openclaw.tool.review_code",
          "group": "1_analyze@2"
        },
        {
          "command": "openclaw.tool.find_bugs",
          "group": "1_analyze@3"
        },
        {
          "command": "openclaw.tool.explain_code",
          "group": "1_analyze@4"
        },
        {
          "command": "openclaw.tool.refactor_code",
          "group": "2_transform@1"
        },
        {
          "command": "openclaw.tool.generate_docs",
          "group": "2_transform@2"
        },
        {
          "command": "openclaw.tool.translate_code",
          "group": "2_transform@3"
        },
        {
          "command": "openclaw.tool.security_analysis",
          "group": "3_audit@1"
        },
        {
          "command": "openclaw.tool.optimize_performance",
          "group": "3_audit@2"
        },
        {
          "command": "openclaw.tool.analyze_complexity",
          "group": "3_audit@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "openclaw.submenu",
        "label": "Navyug AI"
      }
    ],
    "configuration": {
      "title": "Navyug AI",
      "properties": {
        "openclaw.backendUrl": {
          "type": "string",
          "default": "http://localhost:3579",
          "description": "Navyug AI backend URL"
        },
        "openclaw.defaultProvider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "gemini",
            "ollama",
            "vllm"
          ],
          "description": "Default LLM provider"
        },
        "openclaw.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model (leave empty for provider default)"
        },
        "openclaw.streamResponses": {
          "type": "boolean",
          "default": true,
          "description": "Stream responses word-by-word"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}