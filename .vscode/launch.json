{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run OpenClaw Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/LangChain_Extension/frontend"
            ],
            "outFiles": [
                "${workspaceFolder}/LangChain_Extension/frontend/out/**/*.js"
            ],
            "preLaunchTask": "npm: compile - frontend"
        }
    ]
}