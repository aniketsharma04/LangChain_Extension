# ==============================================================
# OpenClaw Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# cp .env.example .env
# ==============================================================


# --------------------------------------------------------------
# SERVER
# --------------------------------------------------------------

# Port the FastAPI server listens on (default: 3579)
# Must match openclaw.backendUrl in VS Code settings
PORT=3579

# Host binding — use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Default LLM provider when none specified in request
# Options: openai | gemini | ollama | vllm | (any custom name)
DEFAULT_PROVIDER=gemini


# --------------------------------------------------------------
# CLOUD PROVIDERS (at least one required for non-local use)
# --------------------------------------------------------------

# OpenAI — https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo, o3-mini
# OPENAI_API_KEY=sk-...

# Google Gemini — https://aistudio.google.com/app/apikey
# Models: gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro
GEMINI_API_KEY=AIzaSyBodPT3T7mTnQSGngX4obeuPh1xMHrrOco
GOOGLE_API_KEY=AIzaSyBodPT3T7mTnQSGngX4obeuPh1xMHrrOco


# --------------------------------------------------------------
# LOCAL PROVIDERS (optional — no API key needed)
# --------------------------------------------------------------

# Ollama — https://ollama.ai
# Run: ollama pull llama3.2
# Only change if Ollama runs on a different port
OLLAMA_URL=http://192.168.3.191:11434

# vLLM — https://docs.vllm.ai
# Run: python -m vllm.entrypoints.openai.api_server --model <model>
# Uncomment and set if using vLLM
# VLLM_URL=http://localhost:8000


# --------------------------------------------------------------
# CUSTOM TOOLS
# --------------------------------------------------------------

# Directory for .yaml custom tool definitions (hot-reloads on change)
# Default: ./custom_tools
# CUSTOM_TOOLS_DIR=./custom_tools

# Tavily Web Search (optional, free tier: 1000 searches/month)
# TAVILY_API_KEY=tvly-...
